# Hercule Backend - Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# REQUIRED: LLM API Key
# =============================================================================

# Gemini API Key - Get free key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# OPTIONAL: Configuration
# =============================================================================

# Storage mode: "local" (default) or "cosmos" (Azure Cosmos DB)
# For Railway deployment, use "local"
STORAGE_MODE=local

# Allowed origins for CORS (comma-separated)
# Use "*" for development, restrict in production
ALLOWED_ORIGINS=*

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# AZURE COSMOS DB (only if STORAGE_MODE=cosmos)
# =============================================================================

# COSMOS_CONNECTION_STRING=your_cosmos_connection_string_here
# COSMOS_DATABASE_NAME=privacy-analyzer
# COSMOS_CONTAINER_NAME=analysis-cache
