# ============================================
# Groq API Configuration
# Get your free API key at https://console.groq.com/
# ============================================
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# ============================================
# Google Search API (Optional - fallback for policy discovery)
# ============================================
GOOGLE_SEARCH_API=your_google_search_api_key_here
# GOOGLE_SEARCH_CX=your_custom_search_engine_id

# ============================================
# General Configuration
# ============================================
# CORS allowed origins (comma-separated, use * for development)
ALLOWED_ORIGINS=*

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ============================================
# Storage Configuration
# ============================================
# Storage mode: "local" (JSON file) or "cosmos" (Azure Cosmos DB)
STORAGE_MODE=local

# Cache TTL in days
CACHE_TTL_DAYS=30

# ============================================
# Azure Cosmos DB (required if STORAGE_MODE=cosmos)
# ============================================
# COSMOS_CONNECTION_STRING=AccountEndpoint=https://your-account.documents.azure.com:443/;AccountKey=your-key
# COSMOS_DATABASE_NAME=privacy-analyzer
# COSMOS_CONTAINER_NAME=analysis-cache

# ============================================
# API Key Pool (Advanced)
# ============================================
# User-provided API keys are stored in backend/keys.json
# Keys are automatically rotated on rate limits (429 errors)
# Priority: user key (from extension) > keys.json pool > GROQ_API_KEY
